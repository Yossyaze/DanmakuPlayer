{
    "manifest_version": 3,
    "name": "DanmakuPlayer Helper",
    "version": "1.2.2",
    "description": "リンクやページをDanmakuPlayerで開く。HLSストリーム(m3u8)の自動検出機能付き。",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "activeTab",
        "contextMenus",
        "storage",
        "webRequest"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "DanmakuPlayerで開く",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "http://localhost:5174/*",
                "https://yossyaze.github.io/DanmakuPlayer/*"
            ],
            "js": ["content_script.js"]
        }
    ],
    "host_permissions": [
        "<all_urls>"
    ]
}