{
  "manifest_version": 3,
  "name": "DanmakuPlayer Helper",
  "version": "5.1.5",
  "description": "リンクやページをDanmakuPlayerで開く。HLSストリーム(m3u8)の自動検出機能付き。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "webRequest",
    "cookies",
    "declarativeNetRequest"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DanmakuPlayerで開く",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/toolbar_icon16.png",
      "32": "icons/toolbar_icon32.png",
      "48": "icons/toolbar_icon48.png",
      "128": "icons/toolbar_icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://localhost:5174/*",
        "https://yossyaze.github.io/DanmakuPlayer/*"
      ],
      "js": ["content_script.js"]
    }
  ],
  "host_permissions": ["<all_urls>"]
}
